# ================= oopz QQ 群机器人 配置模板 =================
# 复制为 .env 后按注释填写：copy .env.example .env
# 各字段含义与获取方式见 DEPLOY.md。

# --- NoneBot 通用 ---
DRIVER=~aiohttp
LOG_LEVEL=INFO   # 生产建议 INFO；排查时临时改 TRACE 看完整调试日志
QQ_IS_SANDBOX=false
# QQ 官方版（bot.py）机器人凭据：在 QQ 开放平台（q.qq.com）创建应用后填 AppID / AppSecret
QQ_BOTS='[{"id": "<AppID>", "secret": "<AppSecret>", "token": "", "intent": {"c2c_group_at_messages": true}}]'
# 官方版群白名单：逗号分隔 group_openid；留空 = 不限制（所有群都可触发查询）
QQ_ALLOWED_GROUPS=

# --- NapCat / OneBot v11 版（bot_napcat.py，推荐入口） ---
# 正向 WS：NoneBot 作为客户端连到 NapCat 的 WS 服务（端口 3001）
ONEBOT_V11_WS_URLS='["ws://127.0.0.1:3001"]'
# NapCat WebUI「正向 WebSocket」服务里生成的鉴权 token（Bearer xxx），必须一致
ONEBOT_V11_ACCESS_TOKEN=<从NapCat WebUI复制>

# --- oopz 平台凭据（先运行 tools/oopz_login.py 生成，再回填到这里） ---
OOPZ_DEVICE_ID=<device_id>
OOPZ_PERSON_UID=<person_uid>
OOPZ_JWT_TOKEN=<jwt_token>
# 私钥 PEM 多行用字面 \n 连接成一行（.env 里不要有真实换行）
OOPZ_PRIVATE_KEY=<private_key单行，换行处写\n>
OOPZ_APP_VERSION=73817

# 限定统计范围：只统计该域（area）的语音频道，逗号分隔 area_id 或域名
OOPZ_TARGET_AREAS=<域名或area_id，逗号分隔>
# @机器人 触发 oopz 查询的关键词（逗号分隔，不区分大小写）；留空 = 用默认值 oopz
OOPZ_TRIGGER=oopz
# @查询群白名单（逗号分隔群号）；留空 = 所有群都可查。
# 注意「群白名单」限制的是**哪个群**，不是哪个人；与「MC 玩家白名单」（服务端
# whitelist.json）毫无关系，后者见下面的 MC_ADMIN_QQ。
# 这是 oopz 查询的白名单；MC 查询另有 MC_ALLOWED_GROUPS，留空时会回退到这个值
NAPCAT_ALLOWED_GROUPS=<群号，逗号分隔多个>

# --- 定时播报 / 进频道欢迎（NapCat 版自动功能） ---
# 目标群号：机器人所在的 QQ 群，逗号分隔多群；留空 = 不启用对应功能
# 播报仅在 oopz 有人在线时推送，无人时静默跳过
NAPCAT_REPORT_GROUP=<群号，逗号分隔多个>
# 播报间隔（分钟），整点对齐：间隔 30 分钟则在 :00/:30 播报，间隔 60 则每小时整点
NAPCAT_REPORT_INTERVAL_MIN=30
NAPCAT_WELCOME_GROUP=<群号，逗号分隔多个>
NAPCAT_WELCOME_INTERVAL_SEC=15
# 可选：只欢迎这些频道（逗号分隔频道名），留空 = 统计范围内全部频道
NAPCAT_WELCOME_CHANNELS=

# --- Minecraft 服务器监听（NapCat 版） ---
# 服务端准备（改完 server.properties 需重启 MC 服务端）：
#   enable-rcon=true
#   rcon.port=25575
#   rcon.password=<强密码>
#   broadcast-rcon-to-ops=false   ← 默认是 true！不改的话每 20 秒一次的 list
#                                    会把玩家名单广播给所有在线 OP，聊天框持续刷屏
# 安全：RCON 是明文协议、密码可被重放，rcon.port 只绑内网/本机，别暴露公网。
MC_HOST=127.0.0.1
MC_PORT=25565
MC_NAME=我的世界服务器          # 消息里显示的服务器名
MC_TIMEOUT=5                    # SLP 探测超时（秒）
# @机器人 触发 MC 查询的关键词（逗号分隔，不区分大小写）；留空 = 用默认值
MC_TRIGGER=mc,我的世界,服务器
# MC **查询的群白名单**（限制哪些 QQ 群能 @查询，不是玩家名单）；
# 留空 = 回退到上面的 NAPCAT_ALLOWED_GROUPS，再留空 = 所有群都可查
MC_ALLOWED_GROUPS=
MC_QUERY_MAX_NAMES=50           # 消息里最多列多少个玩家名

# RCON：用于拿完整名单。留空 = 完全不尝试 RCON，
# 此时降级用 SLP 的玩家样本——在线人数 ≤12 时它同样是完整名单，超过就只能显示可能不完整的部分。
MC_RCON_PORT=25575
MC_RCON_PASSWORD=
MC_RCON_TIMEOUT=5

# --- MC 玩家白名单管理（@机器人 whitelist …，服务端 whitelist.json） ---
# 在群里管理服务端白名单，不用登控制台。命令通过 RCON 执行，所以必须先配 MC_RCON_PASSWORD。
# 只有下列 QQ 号能用这些命令。**留空 = 该功能对所有人关闭**（不是「所有人可用」）——
# 和其他「留空 = 不限制」的配置相反，这是刻意的：配错的后果是任何人都能改服务端白名单。
# 注意与上面的「群白名单」是两回事：MC_ALLOWED_GROUPS 限制「哪个群」，这里限制「哪个人」。
MC_ADMIN_QQ=<你的QQ号，逗号分隔多个>
# 触发管理命令的关键词（逗号分隔，不区分大小写）；留空 = whitelist
# 别填 add / remove / list（它们本身就是子命令），也别跟 MC_TRIGGER 用同一个词——
# 命中本关键词的消息会被管理插件独占，查询插件就不再应答了
MC_ADMIN_TRIGGER=whitelist
# 提示：本功能只读写服务端 whitelist.json，**不会**替你打开 server.properties 里的
# white-list。若白名单里有人却仍能自由进出，去服务端确认 white-list=true。

# 进服提醒：留空 = 不启用（只推进服，不推退服）
MC_WATCH_GROUP=<群号，逗号分隔多个>
MC_WATCH_INTERVAL_SEC=10        # 轮询间隔（秒），决定进服多久被发现
MC_JOIN_MIN_INTERVAL_SEC=5     # 进服推送最小间隔（秒），窗口内的进服合并成一条；0 = 立刻推
MC_NOTIFY_SERVER_STATE=true     # 服务器连不上 / 恢复时是否提醒
# 定时播报：留空 = 不启用；无人在线时静默跳过（与 oopz 播报一致）
MC_REPORT_GROUP=<群号，逗号分隔多个>
MC_REPORT_INTERVAL_MIN=60       # 播报间隔（分钟），整点对齐
