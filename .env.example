# ================= oopz QQ 群机器人 配置模板 =================
# 复制为 .env 后按注释填写：copy .env.example .env
# 各字段含义与获取方式见 DEPLOY.md。

# --- NoneBot 通用 ---
DRIVER=~aiohttp
LOG_LEVEL=INFO   # 生产用 INFO；排查时临时改 TRACE 看完整调试日志
# ↓ 下面三行**只对 QQ 官方版（bot.py）有意义**，NapCat 版（bot_napcat.py）完全不读它们。
#   用推荐入口时不必填、改了也不会有什么效果。
QQ_IS_SANDBOX=false
# QQ 官方版（bot.py）凭据：q.qq.com 创建应用后填 AppID / AppSecret
QQ_BOTS='[{"id": "<AppID>", "secret": "<AppSecret>", "token": "", "intent": {"c2c_group_at_messages": true}}]'
# 官方版群白名单：逗号分隔 group_openid；留空 = 不限制
QQ_ALLOWED_GROUPS=

# --- NapCat / OneBot v11 版（bot_napcat.py，推荐入口） ---
# NoneBot 作为客户端连到 NapCat 的正向 WS（端口 3001）
ONEBOT_V11_WS_URLS='["ws://127.0.0.1:3001"]'
# NapCat WebUI 里生成的鉴权 token，两边必须一致
ONEBOT_V11_ACCESS_TOKEN=<从NapCat WebUI复制>

# --- oopz 平台凭据（先运行 tools/oopz_login.py 生成，再回填） ---
# ⚠️ 下面四个是 oopz 功能的**硬依赖**：缺任何一个 oopz 客户端都建不起来（查询/播报/
#    欢迎全哑，群里会回一句「凭据未配置」）。**但这只影响 oopz** —— 留空这里（或者
#    当初装依赖时没要 oopz_sdk），MC 查询 / 白名单照常工作，机器人照常启动
#    （DEPLOY.md 第 3 节）。oopz_sdk 本身是**默认装的**，不用特意去装。
# ⚠️ 你的 oopz 手机号 / 密码**不要写进本文件** —— oopz_login.py 不读 .env，它只认
#    终端里临时设的环境变量（Windows: $env:OOPZ_LOGIN_PHONE=... ；Linux: 前缀写
#    在命令前面）。生成的四个值由脚本自己写回 .env。
OOPZ_DEVICE_ID=<device_id>
OOPZ_PERSON_UID=<person_uid>
OOPZ_JWT_TOKEN=<jwt_token>
# PEM 私钥：多行用字面 \n 连成一行（.env 里不能有真换行）
OOPZ_PRIVATE_KEY=<private_key单行，换行处写\n>
OOPZ_APP_VERSION=73817

# 统计范围：只看这些域的语音频道，逗号分隔 area_id 或域名
OOPZ_TARGET_AREAS=<域名或area_id，逗号分隔>
# 触发 oopz 查询的关键词，逗号分隔；留空 = 默认 oopz
OOPZ_TRIGGER=oopz
# oopz 查询的群白名单，逗号分隔；留空 = 所有群可查
# 这是「哪个群」的白名单，与 MC 的群范围（mcs_audiences.toml）无关，
# 也与服务端 whitelist.json 无关。
NAPCAT_ALLOWED_GROUPS=<群号，逗号分隔多个>

# --- oopz 定时播报 / 进频道欢迎 ---
# 目标群号，逗号分隔；留空 = 不启用。播报只在有人在线时推，无人时静默跳过
NAPCAT_REPORT_GROUP=<群号，逗号分隔多个>
# 播报间隔（分钟），整点对齐：30 就在 :00/:30 播，60 就每小时整点
NAPCAT_REPORT_INTERVAL_MIN=30
NAPCAT_WELCOME_GROUP=<群号，逗号分隔多个>
NAPCAT_WELCOME_INTERVAL_SEC=15
# 只欢迎这些频道，逗号分隔；留空 = 统计范围内全部频道
NAPCAT_WELCOME_CHANNELS=

# --- Minecraft 服务器 ---
# ⚠️ 服务器地址 / 显示名 / 超时 / RCON 密码**不在这个文件里**：
#    每台一段的 [[targets]] 在 mcs_servers.toml，「哪个群看哪几台、白名单发给谁、
#    默认先看哪台」在 mcs_audiences.toml。两份都要有（各自由 .example 复制），
#    本文件只留「行为类」开关。两份 .toml 改了都要**重启机器人**才生效。
#
#    想换一份配置而不动仓库根的那两份（比如临时挂一份测试清单联调），用下面这两个
#    环境变量指过去。留空 = 用默认位置（仓库根的 mcs_servers.toml / mcs_audiences.toml）：
# MCS_SERVERS_TOML=D:\path\to\test_servers.toml
# MCS_AUDIENCES_TOML=D:\path\to\test_audiences.toml
#
#    排查「新加的服 / 新加的群为什么没生效」先跑：
#        .venv\Scripts\python.exe tools\mc_check.py --list-targets
#        .venv\Scripts\python.exe tools\mc_check.py --list-audiences
#    它们只读配置、不联网，会把读的是哪个文件、每个目标的名字、哪些群在看它、
#    有哪些配置冲突全打出来。配置确认无误后再实机验连通性：
#        .venv\Scripts\python.exe tools\mc_check.py --audience <关联名> [--target bingo]
#
#    每台服务端的准备（改完 server.properties 要重启 MC 服务端）：
#      enable-rcon=true
#      rcon.port=<每台一个，别撞>      rcon.password=<强密码>
#      broadcast-rcon-to-ops=false   ← 缺省是 true！不改的话机器人每
#                                        MC_WATCH_INTERVAL_SEC（默认 10）秒一次的
#                                        list 会把玩家名单广播给所有在线 OP，持续刷屏
#    安全：RCON 是明文协议、密码可被重放，rcon.port 只绑内网/本机，别暴露公网。

# 触发 MC 查询的关键词，逗号分隔；留空 = 用默认值
MC_TRIGGER=mc,我的世界,服务器
# 消息里最多列多少个玩家名（多目标时按目标数均分额度）
MC_QUERY_MAX_NAMES=50

# --- MC 进服提醒 / 定时播报 ---
# 「哪个群收推送」由 mcs_audiences.toml 里那条群关联的 watch / report 决定，
# 「盯哪几台」就是那条关联的 targets。下面几个留在这里不动：它们是整台机器人的
# 节奏，不是某个群的偏好（抄进每条关联只会变成「A 群改了 B 群没改」）。
# 进服轮询间隔（秒），决定进服多久被发现
MC_WATCH_INTERVAL_SEC=10
# 进服推送最小间隔（秒），窗口内的进服合并成一条；0 = 立刻推
MC_JOIN_MIN_INTERVAL_SEC=15
# 服务器连不上 / 恢复时是否提醒
MC_NOTIFY_SERVER_STATE=true
# 推送的是「进服」和「换服」（同组两台之间移动，如 大厅 → Bingo），**退服不推** ——
# 这是既有产品决策，不是漏了：leave 事件在对账层照常产出，只是渲染时不发。
# 播报间隔（分钟），整点对齐；无人在线时静默跳过
MC_REPORT_INTERVAL_MIN=60

# --- MC 玩家白名单管理（@机器人 whitelist …） ---
# 在群里管理服务端白名单，不用登控制台。
# **发给哪台服、RCON 里发什么命令前缀**由 mcs_audiences.toml 里本群那条 [[audience]]
# 的 whitelist 段决定（不是这个文件，也不是 mcs_servers.toml）。前缀必须与服务端
# 插件注册的命令一字不差，写错的表现是每次操作都回 Unknown command、群里报「未生效」，
# 而且**不报错**。本群那条没写 whitelist → 回「本群没有指定白名单服」。
# 那一项指向**接口型目标**时前缀不起作用（接口直接收结构化数据），端口和拦截开关
# 都由对方管；那台服自己两条通道都没配的话，群里会回「白名单服 X 两条通道都没配」。
#
# 只有下列 QQ 号能用这些命令。**留空 = 该功能对所有人关闭**（不是「所有人可用」）——
# 和其他「留空 = 不限制」的配置相反，这是刻意的：配错的后果是任何人都能改服务端白名单。
MC_ADMIN_QQ=<你的QQ号，逗号分隔多个>
# 触发管理命令的关键词，逗号分隔；留空 = whitelist
# 别填 add / remove / list（它们本身就是子命令），也别跟 MC_TRIGGER 用同一个词——
# 命中本关键词的消息会被管理插件独占，查询插件就不再应答了
MC_ADMIN_TRIGGER=whitelist
# 本功能只读写服务端 whitelist.json，**不会**替你打开 server.properties 里的
# white-list。若白名单里有人却仍能自由进出，去服务端确认 white-list=true。
