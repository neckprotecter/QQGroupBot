# ================= oopz QQ 群机器人 配置模板 =================
# 复制为 .env 后按注释填写：copy .env.example .env
# 各字段含义与获取方式见 DEPLOY.md。

# --- NoneBot 通用 ---
DRIVER=~aiohttp
LOG_LEVEL=INFO   # 生产建议 INFO；排查时临时改 TRACE 看完整调试日志
QQ_IS_SANDBOX=false
# QQ 官方版（bot.py）机器人凭据：在 QQ 开放平台（q.qq.com）创建应用后填 AppID / AppSecret
QQ_BOTS='[{"id": "<AppID>", "secret": "<AppSecret>", "token": "", "intent": {"c2c_group_at_messages": true}}]'
# 官方版群白名单：逗号分隔 group_openid；留空 = 不限制（所有群都可触发查询）
QQ_ALLOWED_GROUPS=

# --- NapCat / OneBot v11 版（bot_napcat.py，推荐入口） ---
# 正向 WS：NoneBot 作为客户端连到 NapCat 的 WS 服务（端口 3001）
ONEBOT_V11_WS_URLS='["ws://127.0.0.1:3001"]'
# NapCat WebUI「正向 WebSocket」服务里生成的鉴权 token（Bearer xxx），必须一致
ONEBOT_V11_ACCESS_TOKEN=<从NapCat WebUI复制>

# --- oopz 平台凭据（先运行 tools/oopz_login.py 生成，再回填到这里） ---
OOPZ_DEVICE_ID=<device_id>
OOPZ_PERSON_UID=<person_uid>
OOPZ_JWT_TOKEN=<jwt_token>
# 私钥 PEM 多行用字面 \n 连接成一行（.env 里不要有真实换行）
OOPZ_PRIVATE_KEY=<private_key单行，换行处写\n>
OOPZ_APP_VERSION=73817

# 限定统计范围：只统计该域（area）的语音频道，逗号分隔 area_id 或域名
OOPZ_TARGET_AREAS=<域名或area_id，逗号分隔>
# 只允许这些群触发 @查询（逗号分隔群号）；留空 = 所有群都可查
NAPCAT_ALLOWED_GROUPS=<群号，逗号分隔多个>

# --- 定时播报 / 进频道欢迎（NapCat 版自动功能） ---
# 目标群号：机器人所在的 QQ 群，逗号分隔多群；留空 = 不启用对应功能
# 播报仅在 oopz 有人在线时推送，无人时静默跳过
NAPCAT_REPORT_GROUP=<群号，逗号分隔多个>
# 播报间隔（分钟），整点对齐：间隔 30 分钟则在 :00/:30 播报，间隔 60 则每小时整点
NAPCAT_REPORT_INTERVAL_MIN=30
NAPCAT_WELCOME_GROUP=<群号，逗号分隔多个>
NAPCAT_WELCOME_INTERVAL_SEC=15
# 可选：只欢迎这些频道（逗号分隔频道名），留空 = 统计范围内全部频道
NAPCAT_WELCOME_CHANNELS=
