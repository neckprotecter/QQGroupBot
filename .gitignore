# ============================================================
# 敏感配置（含全部密钥，绝不推送）
#   - QQ AppSecret、NapCat WS token、oopz JWT + RSA 私钥、device_id/person_uid
#   - 部署请复制 .env.example 为 .env 再填写
# ============================================================
.env
.env.*
!.env.example

# 多服务器目标表（含各子服 RCON 密码，绝不上传）
# 部署请复制 mcs_servers.toml.example 为 mcs_servers.toml 再填写
mcs_servers.toml
mcs_servers.toml.*
!mcs_servers.toml.example

# 群关联表（一个 QQ 群看哪几台服）。**不含任何密码**，但含真实 QQ 群号，
# 与 .env.example 用占位符的惯例一致，所以同样不推送。
# 部署请复制 mcs_audiences.toml.example 为 mcs_audiences.toml 再填写
mcs_audiences.toml
mcs_audiences.toml.*
!mcs_audiences.toml.example

# ============================================================
# Python 运行时 / 字节码
# ============================================================
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# ============================================================
# 运行时产物（不推送）
#   - NapCat/：完整协议端运行时（node + QQ NT 原生库 + QQ 登录会话 +
#     onebot11 config 里的 WS 鉴权 token），部署时单独下载安装
#   - napcat-data/：Linux 上 NapCat **容器**的两个卷（同上，只是换了 Docker 形态）
#   - logs/：运行日志（含群消息内容、群号、oopz 昵称等）
# ============================================================
NapCat/
napcat-data/
logs/
*.log

# ============================================================
# IDE / 系统
# ============================================================
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store
