# ============================================================
# 群关联：每个 QQ 群看哪几台 MC 服务器
#
# **复制本文件为 mcs_audiences.toml 再填**（它已在 .gitignore 里，不会上传）。
#
# ⚠️ 本文件**不含任何密码** —— 各服的 RCON 密码在 mcs_servers.toml 里。所以这一份
#    可以单独给人看、单独贴出来讨论。前提是别把密码抄进来。
#
# 一条 [[audience]] = 一条「群关联」：把一组 QQ 群关联到一组服务器。
# 群能不能用 MC 功能，就看它有没有出现在这里 —— **被提到就算开通，没提到就不开通**
# （群里会明确回一句「本群还没有开通 MC 查询」，并在日志里留一条 warning）。
# 所以 .env 里的 MC_ALLOWED_GROUPS 已经不作数了，留着会被当成残留报一条警告。
#
# ⚠️ 「被提到 = 开通查询」**不包含推送**。查询是群友拉（问了才答），推送是机器人自己
#    说话，所以进服提醒 / 定时播报要不要发给这个群，由本条自己的 watch / report 决定，
#    **缺省都是关的**。新加一条关联不会悄悄让那个群开始收推送。
#
# ⚠️ 改完要**重启机器人**。排查「新加的群为什么不响应」先跑：
#        .venv\Scripts\python.exe tools\mc_check.py --list-audiences
#    它只读配置、不联网，会把每条关联覆盖哪些群、关联到哪几台服、白名单发给谁、
#    推送开了哪些、以及「哪些服没被任何群关联」全打出来。
#
# 字段（一个都不认识的键会**直接报错**，不会静默忽略）：
#   name      必填。这条关联的名字，日志和诊断里用它指代本条。**不能重名。**
#             **只在运维看的输出里出现**，群里的文案一律说「本群」，不带这个名字。
#   groups    必填，非空。这条关联覆盖的 QQ 群号，逗号分隔写多个。
#             整数或字符串都行，带引号只是为了好看。
#   targets   可选，**可以为空**。关联到哪几台服，写 mcs_servers.toml 里的 id。
#             顺序 = 群里「总览」的展示顺序。写成 [] 表示这个群先占位、服还没搭。
#   primary   可选。本群默认先看哪台（总览里排最前）。必须写在本条的 targets 里。
#             不写 = 本条的第一个。注意它和「targets 的顺序」是两回事：顺序只决定
#             --list-targets 的打印次序。
#   whitelist 可选，整段省略 = 本群不管白名单。是**一组表**（每台白名单服一项）：
#               第 N 项.target  = 命令发给哪台（必须是本条的 targets 之一）
#               第 N 项.command = 这一台的 RCON 前缀，可省（缺省 "whitelist"），
#                                 见下面第 3 条
#             单表写法（whitelist = { ... }）从 P6 起**直接报错**：一个群可以管多台服，
#             而每台的前缀可能不同，一份表说不清。报错里带了可照抄的改法。
#   watch     可选，缺省 false。true = 本条的 groups 收**进服提醒**（有人进服就报）。
#   report    可选，缺省 false。true = 本条的 groups 收**定时播报**（默认每小时一次）。
#             两个开关都只管「发不发」，**收件人恒为本条的 groups**，没有第二个地方
#             需要写群号。必须是 TOML 的真布尔：watch = "true" 或 watch = 1 都报错。
#
# 为什么这里只有开关、没有间隔：
#   「多久播一次」「进服提醒最小间隔」这类参数**继续留在 .env**
#   （MC_WATCH_INTERVAL_SEC / MC_JOIN_MIN_INTERVAL_SEC /
#     MC_REPORT_INTERVAL_MIN / MC_NOTIFY_SERVER_STATE）。
#   那是**整台机器人的节奏**，不是某个群的偏好。抄进 N 条关联只会变成
#   「A 群改了 B 群没改」，而且改了其中一条完全看不出另外几条是什么值。
# ============================================================


# ------------------------------------------------------------
# 社团群：看自己的三台服
# ------------------------------------------------------------
[[audience]]
name    = "社团群"
groups  = [<群号>]                       # 多个群共享同一条关联就写 [11111111, 22222222]
targets = ["gtnh", "bingo", "backstabbed"]
primary = "gtnh"                         # 不带服名的 @查询 默认看它，总览里也排最前

# 白名单管理：**一组表，每台白名单服一项**。整段删掉 = 这个群不能用 whitelist 命令
# （群里会回「本群没有指定白名单服」）。
#
# 只有一台时是这样（command 可省，省了就是 "whitelist"）：
whitelist = [{ target = "bingo", command = "whitelist" }]
#
# 代理上线后是这样（两台各带自己的前缀，顺序 = 配置里的书写顺序）：
#   whitelist = [
#     { target = "bingo" },                                   # 子服：插件自带 whitelist
#     { target = "proxy", command = "globalwhitelist" },       # 代理：Global Whitelist
#   ]
#
# ⚠️ 多写一台 = **同一个人能改的服务器多一台**。管理员是 .env 的 MC_ADMIN_QQ 里的
#    QQ 号，鉴的是「人」、**不分服**，所以这里每加一项，那个人的权限就跟着变大一圈，
#    而任何输出里都不会体现这件事。加之前先想一遍该不该给。
#
# 群里怎么点名：命令里**服名写在最后**，一次只打一台。
#   @bot whitelist add Steve bingo     → 加到 bingo
#   @bot whitelist remove Steve        → 只有一台时可以省服名
#   @bot whitelist list                → 不点名 = 一次列出本群全部白名单服
#   @bot whitelist list bingo          → 只看那一台
# 多台时不写服名会被要求点名，**没有「默认那台」的回退** —— 猜错就是改错服务器的
# 白名单。改动命令（add / remove）一律只影响点名的这一台；想批量改，一条条来。

# 推送开关：不写 = 不推送。想让这个群收进服提醒 / 定时播报就把对应的那行改成 true。
watch   = true
report  = true


# ------------------------------------------------------------
# 建筑群：组服还没搭，先占位
#
# targets = [] 是**合法**的，不是「没配完」。那个群的查询会回
# 「本群关联的服务器还没接入，暂时没有可查询的内容」——
# 比笼统的「本群还没有开通」准确：开通了，只是没服可看。
# 等组服搭好，把 id 填进 targets 就行。
#
# 这条**也不写 watch / report**：targets 是空的时候开推送没有任何输出，只会
# 多一条警告。服搭好、targets 填上，再按需要开开关 —— 开关不用改，加了 targets
# 之后它就自动开始生效。
# ------------------------------------------------------------
[[audience]]
name    = "建筑群"
groups  = [<群号>]
targets = []


# ------------------------------------------------------------
# 填这份文件时容易踩的五个坑
# ------------------------------------------------------------
#
# 1. 一个群只能出现在一条 [[audience]] 里
#    同一个群号写进两条会**直接报错**。不是洁癖：那样「这个群查询该看哪几台」
#    就说不清了，而取先出现的那条正是本工程一直在防的「静默猜」。
#    想让几个群看同样的服，就把群号都写在同一条的 groups 里。
#
# 2. 关联外的服名查不到（这是刻意的隔离）
#    建筑群打 "@bot mc gtnh" 会回「没有叫 gtnh 的服」—— 不是 bug。每条的服务器视图
#    是独立投影的，社团群的服名在建筑群那边根本不存在。
#    反过来，**新加的服忘了关联给任何群**是很常见的疏漏：群里打它回「没这个服」，
#    而 --list-targets 和启动日志都会正常列出它。所以加载时会专门警告
#    「XXX 没被任何群关联」，--list-audiences 里也有单独一段。看到就补 targets。
#
# 3. whitelist 里每一台的 command 必须与服务端插件注册的命令一字不差
#    写错的表现是每次操作都回 Unknown command、群里报「未生效」，而且**不报错**。
#      vanilla / NekoList   → whitelist
#      Global Whitelist     → globalwhitelist    ← 代理上线后多半是这个
#      ProxyWhitelist       → pwl
#      VelocitySafe         → vwhitelist
#    别和「触发词」搞混：
#      触发词   = 群友在群里打的词（.env 的 MC_ADMIN_TRIGGER，默认 whitelist）
#      命令前缀 = 机器人通过 RCON 发给服务端的词（就是这个字段）
#    今天两者恰好都叫 whitelist。代理上线后必然分叉：群里照样打 whitelist，
#    而 RCON 里要发 globalwhitelist。
#    **多台时逐台都要对**：一台写错只影响那一台，而群里点它的名时才回「未生效」，
#    不点名的那几台一直好好的 —— 只看「list 正常」是发现不了的。--whitelist 会
#    逐台把前缀打出来，对着它核一遍。
#
# 4. 要用代理管白名单，代理得在这条的 targets 里
#    whitelist 里每一项的 target 都必须是**本条 targets** 之一（不是「全量表里有就行」）。
#    代理通常不属于任何群自己看的那几台，所以群组就绪后要给每条要用白名单的
#    [[audience]] 都把 "proxy" 加进 targets —— 否则加载时就报错，不会等到群里发命令才炸。
#    加了 targets 还要**在 whitelist 里加一项** { target = "proxy", command = "globalwhitelist" }：
#    只进 targets 只是「这个群查得到它」，白名单那边还得单独声明。
#
# 5. 多写一台白名单服 = 同一个人能改的服务器多一台
#    管理员是 .env 的 MC_ADMIN_QQ 里的 QQ 号，鉴的是「人」、**不分服**。所以
#    whitelist 里每多一项，那个号能改的白名单就多一份 —— 这是**权限扩大**，
#    但它不会出现在任何输出里（命令、日志、--list-audiences 都只报「发往 N 台」）。
#    加项之前先确认这个人本来就该管那台服。
#
# 另外：进服提醒与定时播报**已经不看 .env 里的群了**。MC_WATCH_GROUP /
# MC_REPORT_GROUP 这两个变量作废，留着会被当成残留报一条警告；「哪个群收」改由本条
# 的 watch / report 决定，而「盯哪几台」就是本条的 targets —— 一条关联挂三台服时，
# 一个周期内这三台的事件会**合成一条**消息发进本条的 groups。
#
# ⚠️ 从旧配置搬过来时顺序别反：
#     1. 先给要收推送的那条 [[audience]] 加上 watch = true / report = true，重启，
#        确认推送照旧；
#     2. 再删掉 .env 里的 MC_WATCH_GROUP / MC_REPORT_GROUP 两行，重启，确认残留警告
#        消失、推送仍在。
#   反过来做（先删变量）会让提醒**静默消失**，而群里安安静静和「机器人挂了」长得
#   一模一样 —— 你会去查机器人，而问题只是少了两行配置。
