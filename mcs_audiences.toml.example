# ============================================================
# 群关联：每个 QQ 群看哪几台 MC 服务器
#
# **复制本文件为 mcs_audiences.toml 再填**（它已在 .gitignore 里，不会上传）。
#
# ⚠️ 本文件**不含任何密码** —— 各服的 RCON 密码在 mcs_servers.toml 里。所以这一份
#    可以单独给人看、单独贴出来讨论。前提是别把密码抄进来。
#
# 一条 [[audience]] = 一条「群关联」：把一组 QQ 群关联到一组服务器。
# 群能不能用 MC 功能，就看它有没有出现在这里 —— **被提到就算开通，没提到就不开通**
# （群里会明确回一句「本群还没有开通 MC 查询」，并在日志里留一条 warning）。
# 所以 .env 里的 MC_ALLOWED_GROUPS 已经不作数了，留着会被当成残留报一条警告。
#
# ⚠️ 改完要**重启机器人**。排查「新加的群为什么不响应」先跑：
#        .venv\Scripts\python.exe tools\mc_check.py --list-audiences
#    它只读配置、不联网，会把每条关联覆盖哪些群、关联到哪几台服、白名单发给谁、
#    以及「哪些服没被任何群关联」全打出来。
#
# 字段（一个都不认识的键会**直接报错**，不会静默忽略）：
#   name      必填。这条关联的名字，日志和诊断里用它指代本条。
#             **只在运维看的输出里出现**，群里的文案一律说「本群」，不带这个名字。
#   groups    必填，非空。这条关联覆盖的 QQ 群号，逗号分隔写多个。
#             整数或字符串都行，带引号只是为了好看。
#   targets   可选，**可以为空**。关联到哪几台服，写 mcs_servers.toml 里的 id。
#             顺序 = 群里「总览」的展示顺序。写成 [] 表示这个群先占位、服还没搭。
#   primary   可选。本群默认先看哪台（总览里排最前）。必须写在本条的 targets 里。
#             不写 = 本条的第一个。注意它和「targets 的顺序」是两回事：顺序只决定
#             --list-targets 的打印次序。
#   whitelist 可选，整段省略 = 本群不管白名单。是一张表：
#               target  = 命令发给哪台（必须是本条的 targets 之一）
#               command = RCON 里实际发的前缀，见下面第 3 条
# ============================================================


# ------------------------------------------------------------
# 社团群：看自己的三台服
# ------------------------------------------------------------
[[audience]]
name    = "社团群"
groups  = [<群号>]                       # 多个群共享同一条关联就写 [11111111, 22222222]
targets = ["gtnh", "bingo", "backstabbed"]
primary = "gtnh"                         # 不带服名的 @查询 默认看它，总览里也排最前

# 白名单管理：命令发给哪台、用什么前缀。整段删掉 = 这个群不能用 whitelist 命令
# （群里会回「本群没有指定白名单服」）。
whitelist = { target = "bingo", command = "whitelist" }


# ------------------------------------------------------------
# 建筑群：组服还没搭，先占位
#
# targets = [] 是**合法**的，不是「没配完」。那个群的查询会回
# 「本群关联的服务器还没接入，暂时没有可查询的内容」——
# 比笼统的「本群还没有开通」准确：开通了，只是没服可看。
# 等组服搭好，把 id 填进 targets 就行。
# ------------------------------------------------------------
[[audience]]
name    = "建筑群"
groups  = [<群号>]
targets = []


# ------------------------------------------------------------
# 填这份文件时容易踩的四个坑
# ------------------------------------------------------------
#
# 1. 一个群只能出现在一条 [[audience]] 里
#    同一个群号写进两条会**直接报错**。不是洁癖：那样「这个群查询该看哪几台」
#    就说不清了，而取先出现的那条正是本工程一直在防的「静默猜」。
#    想让几个群看同样的服，就把群号都写在同一条的 groups 里。
#
# 2. 关联外的服名查不到（这是刻意的隔离）
#    建筑群打 "@bot mc gtnh" 会回「没有叫 gtnh 的服」—— 不是 bug。每条的服务器视图
#    是独立投影的，社团群的服名在建筑群那边根本不存在。
#    反过来，**新加的服忘了关联给任何群**是很常见的疏漏：群里打它回「没这个服」，
#    而 --list-targets 和启动日志都会正常列出它。所以加载时会专门警告
#    「XXX 没被任何群关联」，--list-audiences 里也有单独一段。看到就补 targets。
#
# 3. whitelist.command 必须与服务端插件注册的命令一字不差
#    写错的表现是每次操作都回 Unknown command、群里报「未生效」，而且**不报错**。
#      vanilla / NekoList   → whitelist
#      Global Whitelist     → globalwhitelist    ← 代理上线后多半是这个
#      ProxyWhitelist       → pwl
#      VelocitySafe         → vwhitelist
#    别和「触发词」搞混：
#      触发词   = 群友在群里打的词（.env 的 MC_ADMIN_TRIGGER，默认 whitelist）
#      命令前缀 = 机器人通过 RCON 发给服务端的词（就是这个字段）
#    今天两者恰好都叫 whitelist。代理上线后必然分叉：群里照样打 whitelist，
#    而 RCON 里要发 globalwhitelist。
#
# 4. 要用代理管白名单，代理得在这条的 targets 里
#    whitelist.target 必须是**本条 targets** 之一（不是「全量表里有就行」）。
#    代理通常不属于任何群自己看的那几台，所以群组就绪后要给每条要用白名单的
#    [[audience]] 都把 "proxy" 加进 targets —— 否则加载时就报错，不会等到群里发命令才炸。
#
# 另外：MC_WATCH_GROUP / MC_REPORT_GROUP（.env）里的群**也**必须在这里有对应的
# [[audience]]，否则进服提醒与定时播报会明确报错并停摆。当前阶段它们只看那条关联的
# 主服（P7 会改成按群关联分别对账）。
