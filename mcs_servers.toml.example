# ============================================================
# 多服务器目标表
#
# 机器人能看到的**全部** MC 服务器都在这里，一台一段 [[targets]]。
# **复制本文件为 mcs_servers.toml 再填**（mcs_servers.toml 已在 .gitignore 里，不会上传）。
#
# ⚠️ 本文件含各服 RCON 密码，是明文。别提交、别贴群里。
#
# ⚠️ 本文件**只管「有哪些服」**。「哪个 QQ 群看哪几台」「白名单发给谁」都在另一份
#    mcs_audiences.toml 里（它不含密码，所以可以单独给人看）。两份都要有，缺一份
#    机器人起不来 —— 只填了这台清单、没填群关联，群里会回「本群还没有开通此功能」。
#
# ⚠️ 改完要**重启机器人**（配置在启动时读一次）。
#    排查「新加的服为什么没生效」先跑：
#        .venv\Scripts\python.exe tools\mc_check.py --list-targets
#        .venv\Scripts\python.exe tools\mc_check.py --list-audiences
#    它们只读配置、不联网，会把「读的是哪个文件、每个目标的名字、哪些群在看它、
#    有哪些配置冲突」全打出来。配置确认无误后，再实机验连通性：
#        .venv\Scripts\python.exe tools\mc_check.py --audience 社团群 [--target bingo]
#    服名走和群里同一套解析（id / 名字 / 别名 / 唯一前缀）**且限定在所选关联内**，
#    所以脚本里能跑通的写法，那个群里的群友打出来也一定跑得通。
#
# 三种 kind 的区别：
#   proxy       代理（Velocity / BungeeCord）。**走 SLP 时不出分服名单** —— 它的 SLP
#               只给全群组总人数，也没有可用的 list 命令。它存在的意义是「总人数」
#               「白名单归属」，以及**配了 api 时它是全部子服名单的来源**（子服写
#               source 指向它，见下）—— 这一点最容易漏，别以为代理只能报个总数。
#   backend     挂在代理后面的子服。出名单，参与「换服」对账。
#   standalone  不在代理后面、玩家直连的独立服（模组服通常属于这类）。
#
# 三种**取数通道**（跟 kind 是两回事）：
#   SLP    游戏端口，人人可用 —— 给在线人数、版本、延迟；玩家样本最多 12 个且随机。
#   RCON   自己这台服的控制台 —— 给**完整名单**，也用来改白名单。
#   api    群组那侧自建的 HTTP 接口（Velocity 插件，见 DEPLOY.md）—— 一次响应里
#          带**整组**每个子服的人数与名单。代理那台常常只有这一个口能用：游戏端口
#          没发布出来、RCON 也没开。配了 api 的目标由别人（它的子服）来「挂靠」。
#
# 字段：
#   id        必填。唯一标识，也是 @查询 里打的服名。自动可用，不能有重名。
#   name      必填。消息里显示的名字。
#   kind      必填。proxy / backend / standalone，写错会加载失败。
#   group     可选。**同一 group 内的跳服才算「换服」**。不写 = 用 id 当组名，
#             也就是谁都不跟谁同组。省事起见，一个代理下面的子服填同一个 group。
#   host/port **配了 api 或 source 的目标可选，其余目标两个都必填**（缺 host 报
#             「不能为空」，缺 port 报「超出范围 1~65535：0」）。这两种目标的数据不
#             靠自己取，所以 SLP 只是加分项；但它们**给了才有 SLP**（也就才有延迟、
#             版本和「服务端在不在」的独立佐证）。服务器 server-ip 留空 = 绑
#             0.0.0.0，这里填 127.0.0.1 或那台机器的地址。
#             接口型目标（配了 api 的那台）常常**根本不填** —— 它的游戏端口没发布，
#             填了也连不上。这时它的人数就只有接口一个来源。
#             反过来，**填了是好事**：SLP 会给接口报的人数做独立复查，对不上就报
#             「接口那份数据可疑、已按 SLP 报」（见 --target 输出里的「人数来源」）。
#             ⚠️ 只填 port 不填 host 会**报错**（SLP 要两个一起给）—— 要么都给，
#             要么两个都删。
#   rcon      可选，但**不填就不出名单**（只剩人数）。
#             { host = ..., port = ..., password = ... }
#             **port 必填** —— 没有默认值，写 rcon = { password = "..." } 会报
#             「超出范围 1~65535：0」。
#             password 空 = 该目标完全不尝试 RCON。
#             host 空（默认）= 跟目标自己的 host 相同，绝大多数目标如此。需要单独
#             填是因为**SLP 和 RCON 可以不在一个地址上** —— 典型是 RCON 只绑内网/
#             回环、由 ssh 隧道转出来，而游戏 SLP 走公网端口：
#               host = "203.0.113.10"      # SLP 走公网
#               port = 30004
#               rcon = { host = "127.0.0.1", port = 25575, password = "..." }
#             ⚠️ 这里填的地址是**机器人本机**能连到的地址（隧道这头），不是服务端
#             那台的地址。回环端口要先用 ssh -L 转过来，否则连不上。
#   api       可选。群组那侧自建的 HTTP 接口。**和 rcon 互斥，和 source 也互斥** ——
#             同一台目标两者都填会直接加载失败（都配上就没人说得清实际走哪条，而
#             两条的行为差别很大）。只能配在 kind = "proxy" 的目标上。
#             { url = "http://127.0.0.1:8080", token = "<对方给的 token>" }
#             url **必须写全 http:// 或 https://**，且**只填到端口**，别带路径
#             （/status、/whitelist 由机器人自己拼）—— 两种情况都会报错。
#             token **必填，留空会加载失败**：没有它每条请求都是 401，等于配了一个
#             「永远取不到数据」的目标，所以解析期就拦下，不留到运行时。
#             ⚠️ token 是密码，别提交、别贴群里。
#             ⚠️ 地址同样是**机器人本机能连到的地址**：对方多半把 8080 发到它自己
#             的 127.0.0.1，这边要 ssh -L 转过来（见 DEPLOY.md 的隧道一节）。
#   source    可选。**数据不从我这儿取，去另一台目标的接口里拿**。值是另一条
#             [[targets]] 的 id，那台必须配了 api。群组子服都这么写 —— 一次
#             /status 响应就带全部子服的数据，所以 N 台子服**只发 1 次 HTTP**。
#             挂了 source 的子服自己**不发任何请求**（SLP 也不发，除非它另填了
#             host：那是上面说的独立复查）。
#             挂了 source 的子服**不能**再用 rcon（数据已经在接口那份响应里了）。
#   transit   可选。**中转服**的名字表，只对「配了 api 的代理」有意义。
#             中转服 = 对方 /status 里列出、但不是给人玩的那种子服（Velocity 的
#             limbo 就是标准例子）：玩家在登录握手、换服的一瞬、或者想进的服把他
#             拒了的时候，会被代理放在那里。它们的人**不算进「全群组」人数**。
#               transit = ["limbo"]
#             不写这一项时，总览会出现自相矛盾的一幕 ——「【群组服】全群组 2 人」，
#             而下面几台子服加起来只有 1 人，差额正站在 limbo 里。那个数字没错，
#             但它回答的是「连着代理的有几个」，不是群里想知道的「有几个在玩」。
#             ⚠️ 名字必须与对方 velocity.toml 里的服名**逐字相同**（同 source_key）。
#             对不上时**不会报错**，只是一个人都扣不掉 —— 也就是人数偏大一点点，
#             而这种偏差在群里看不出来。所以启动日志、--list-targets、--api 三处
#             都会把它打出来，--api 还会逐个对号。
#             ⚠️ 只有 kind = "proxy" 且配了 api 才能写；写错会加载失败。
#             ⚠️ 已经挂成子服的那台不能再写进 transit（它的人被扣掉却仍在自己的
#             行里列着，数字照样对不上），也会加载失败。
#   quiet_join 可选（默认 false）。**落地服**（群组服的大厅）用这一项：玩家进服先落在
#             那里，紧接着（同一轮探测内）就换到真正想玩的那台，于是群里连着推两条
#             ——「溜进了大厅」+「从大厅换到生电」，前一条是重复。
#               quiet_join = true
#             只掐「**落在这台的进服**」这一种事件，别的一律不动：
#             · **人数照算**：总览/定时播报/@mc 查询照旧列出这台上的人（那几处答的是
#               「现在有几个人可以一起玩」，在大厅等的人当然算）；
#             · **掉线/恢复照推**（那是「这台服挂了」，与谁在玩无关）；
#             · **换到这台照推**（`🔄 X 从「生电」换到「大厅」`）——换服行两端都写在
#               行里，本来就不会与谁重复。
#             与他同轮到达的换服行照旧发出，所以「进服 → 落大厅 → 换走」在群里只剩一行。
#             ⚠️ 写在 kind = "proxy" 的目标上会**加载失败**：代理那条不参与进服对账
#             （名单是全群组口径），写在它身上永远不会生效。落地服是挂在它下面的子服。
#   source_key 可选。在对方响应里用哪个键取自己（/status 的 servers[].name，也
#             就是**对方 velocity.toml 里的服务器名**）。不填 = 用 id。
#             写错的表现是「接口里没这台」——那时会报错并把接口里**实际有的**
#             服名列出来，照着改即可（--api 模式能看接口原文）。
#             ⚠️ 它**只有配了 source 才有意义**，单独写这一行会加载失败。
#   timeout   可选。SLP 探测超时（秒），不写用 [defaults].timeout。**必须是正数**
#             （写 0 想「关掉超时」会直接报错）。**还必须小于 MC_WATCH_INTERVAL_SEC，
#             否则病态情况下轮询周期会被拉长**（不会重叠，只是变慢；启动日志和
#             --list-targets 都会提示）。上界按「开了 watch 的群关联覆盖到的目标」算
#             （目标之间并发探测，所以取 max 不求和）。接口型目标也用它当 HTTP 超时。
#   rcon_timeout 可选。同上（同样必须为正），不写用 [defaults].rcon_timeout。
#   aliases   可选。群里可以用的别名，方便输入。**它和 id、name 共用一个命名空间**：
#             三者之间、以及两条目标之间都不能撞，而且比较时做了全角/大小写归一化
#             （全角 Ｂｉｎｇｏ 和 bingo 算同一个名字）。**注意服名不要和机器人触发词
#             撞词**，详见文件末尾。
#
# 「白名单归属」和「主服（primary）」不在这里 —— 它们要按 QQ 群区分，写在
# mcs_audiences.toml 的每条 [[audience]] 里（whitelist / primary 两个字段）。
# ============================================================


# ------------------------------------------------------------
# 超时默认值，可被单个 target 覆盖
# ------------------------------------------------------------
[defaults]
timeout      = 5
rcon_timeout = 5


# ------------------------------------------------------------
# 独立模组服（不在代理后面，玩家直连）
# ------------------------------------------------------------

[[targets]]
id   = "gtnh"
name = "GTNH"
kind = "standalone"
host = "127.0.0.1"
port = 25565
rcon = { port = 25575, password = "<RCON 密码>" }


# ------------------------------------------------------------
# 群组子服（挂在 Velocity 代理后面）
#
# 两套写法，**取决于那台代理有没有可用的 HTTP 接口**：
#
#   A) 代理有接口（配了 api）→ 子服写 source，谁的名单都不靠自己取。
#      这是群组服的**首选**：一台接口一次响应就带全部子服的人数与名单，
#      N 台子服只发 1 次 HTTP。子服上没有 RCON 也照样出完整名单。
#
#   B) 代理没有接口 → 子服自己开 RCON（下面这份，最朴素也最稳）。
#
# 两套**不能混**：子服同时写了 source 和 rcon 会直接加载失败（名单从接口来、
# 白名单却走本机控制台，两处会各说各话）。
# ------------------------------------------------------------

[[targets]]
id    = "bingo"
name  = "Bingo"
kind  = "backend"
group = "主服群"
host  = "127.0.0.1"
port  = 25567
rcon  = { port = 25577, password = "<RCON 密码>" }

[[targets]]
id      = "backstabbed"
name    = "谁是杀手"
aliases = ["backstab"]
kind    = "backend"
group   = "主服群"
host    = "127.0.0.1"
port  = 25566
rcon  = { port = 25585, password = "<RCON 密码>" }

# 写法 A：子服挂到代理的接口上。**整段替换**上面那两台 —— 别留下两份同名目标
# （id 重复会报错），也别留着 rcon 只加 source（source 和 rcon 互斥，见本文件
# 末尾的坑 4）。改法三步：
#   1. 删掉 rcon（会直接报错）
#   2. host/port 留着也行：它不再用来出名单，只给接口报的人数做一次 SLP 复查
#      （子服的游戏端口多半没发布，所以更常见的是两个都删）
#   3. source_key 填**对方 velocity.toml 里的服务器名**（不填 = 用这里的 id）
#
# [[targets]]
# id    = "bingo"
# name  = "Bingo"
# kind  = "backend"
# group = "主服群"
# source = "szu"
# # source_key = "bingo"       # 不填就用 id，多数时候够用
#
# # 落地服（大厅）：玩家进服先落在它上面、紧接着换走，所以它的进服提醒要掐掉
# # （详见上面字段说明里的 quiet_join）。写在**子服**这条上，别写在代理那条。
# [[targets]]
# id         = "lobby"
# name       = "大厅"
# kind       = "backend"
# group      = "主服群"
# source     = "szu"
# quiet_join = true


# ------------------------------------------------------------
# 代理
#
# 代理常常在**另一台机器**上。两种取数方式：
#   A) 接口（推荐）：对方装一个 bridge 插件，给一个带 token 的 HTTP 口。
#      游戏端口和 RCON 都不用发布 —— 这是唯一能拿到「整组每个子服名单」的路。
#   B) RCON：要对方把 rcon.port 从防火墙放行（或走隧道）到机器人这边。
#      RCON 是**明文可重放**的，别暴露到公网 —— 要么防火墙限来源，要么 ssh -L
#      （对方把端口发到它自己的 127.0.0.1，这边转过来，两边都不沾公网）。
# ------------------------------------------------------------

# ---- A) 走对方的 HTTP 接口（SZUcraft 那套，见 DEPLOY.md 4.1 的「走群组接口」）----
# [[targets]]
# id    = "szu"
# name  = "主服群"
# kind  = "proxy"          # 接口是群组数据，只有代理用得上（子服写 source）
# group = "主服群"
# api   = { url = "http://127.0.0.1:8080", token = "<对方给的 token>" }
# # 接口地址同样是**机器人本机**能连到的地址：对方多半把 8080 只发到自己那台的
# # 127.0.0.1，这边要 ssh -L 8080:127.0.0.1:8080 转过来。
# # host/port 可选：填了就有 SLP，能给接口报的人数做独立复查（对不上会明说）。
# # host  = "127.0.0.1"
# # port  = 25565
# # 中转服（limbo / 排队房那种，不是给人玩的）：点出来，它们的人不算进「全群组」。
# # 名字要跟对方 velocity.toml 里的服名逐字相同；写错不会报错，只是扣不掉。
# # transit = ["limbo"]
#
# # 白名单跟着数据走：**在 mcs_audiences.toml 里把白名单指向 szu**，
# # 不要再指向子服 —— 代理层的白名单才是进服校验那一道。
# #   whitelist = [{ target = "szu", command = "globalwhitelist" }]
# # command 对接口型目标**不起作用**（接口直接给结构化数据），所以**可以省**；
# # 填了也不生效，不必为此纠结。将来若要切回 RCON 再补上对方插件注册的命令名。

# ---- B) 代理自己开 RCON（Velocircon 之类）----
# [[targets]]
# id    = "proxy"
# name  = "主服群"
# kind  = "proxy"          # 代理不出名单，SLP 给的是全群组总人数
# group = "主服群"
# host  = "<代理所在机器的地址>"
# port  = 25565
# rcon  = { port = 25575, password = "<Velocircon 的密码>" }
#
# # 代理的 rcon 只为白名单服务（它没有 list 命令）。要在 mcs_audiences.toml 里**做两件事**：
# #   1. 把 "proxy" 加进那条 [[audience]].targets（否则白名单项校验不过，加载就报错）
# #   2. 在它的 whitelist 数组里加一项：
# #        { target = "proxy", command = "globalwhitelist" }
# #      command 写插件实际注册的命令（Global Whitelist 是 globalwhitelist）。
# #      子服那一项**保留不动** —— 代理管的是入服校验，子服自己的白名单还在。
#
# # 代理上**不要装 glist 类的插件**。分服名单一律由各子服自己的 RCON 提供，
# # 代理挂了不该让所有子服的名单一起消失。


# ------------------------------------------------------------
# 填这份文件时最容易踩的五个坑
# ------------------------------------------------------------
#
# 1. 端口撞车（不止是「不能同时跑」）
#    两台 host:port 相同时，**探测层面无从分辨** —— 查 A 会把正在跑的 B 的数据
#    当成 A 报出去，界面上看起来完全正常。加载时会警告，但不会报错，所以警告
#    要认真看。每台服给一组独立的 server-port / rcon.port。
#
# 2. broadcast-rcon-to-ops（默认 true，必须改 false）
#    机器人每 MC_WATCH_INTERVAL_SEC 秒发一次 RCON list 取名单。这个开关为 true 时，
#    **每一条 list 的输出都会广播给所有在线 OP** —— 聊天框以 10 秒为周期刷屏。
#    在每台服的 server.properties 里加 broadcast-rcon-to-ops=false，然后重启服务端。
#
# 3. 服务器名别和机器人触发词撞词
#    触发词归属是在整条消息上做子串匹配，且 whitelist / oopz 的优先级高于 mc。
#    所以任何名字里含 whitelist、oopz 的目标**永远当不了 @查询 的参数** ——
#    打 "@bot mc whitelist" 会被白名单插件截走。用 aliases 也绕不过去 ——
#    别名和 id、名字一样参与匹配，改名不解决问题，只能换个词。
#
# 4. 子服别同时写 source 和 rcon
#    source 是「我的在线名单从代理的接口拿」，rcon 是「白名单命令走这台自己的
#    控制台」。两边各自都自洽，所以**不会报错**（现在是加载期直接拒绝），
#    但群里的名单和白名单命令读的那份名单来自两处。真实翻车：代理层的白名单
#    （GlobalWhitelist 之类）才是进服校验那一道，子服自己的白名单加上去看着
#    成功、人还是进不去。挂接口的子服把白名单也交给代理那台。
#
# 5. 别让某台服只有人数、没有名单
#    既没配 rcon.password、也没有接口数据源的目标只会显示人数，“在线名单” 那
#    一段会缺。SLP 自带的玩家样本最多 12 个且是**随机**的，不能当名单用 ——
#    所以机器人宁可说「名单可能不完整」也不拿它凑数。想让某台服出名单：
